@model System.Collections.Generic.IEnumerable<ProductionOrder>

@{
    ViewData["Title"] = "ПФ Дрипы";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">ПФ Дрипы</h1>

    <a asp-action="Create" class="btn btn-primary">
        Создать заказ
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Заказ в 1С</th>
                <th>Дата</th>
                <th>Номенклатура</th>
                <th class="text-end">План</th>
                <th class="text-end">Факт</th>
                <th>Статус</th>
                <th>Действие</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-nowrap">
                        @item.Id1C
                    </td>
                    <td class="text-nowrap">
                        <div>
                            @item.OrderDate.ToString("dd.MM.yyyy")
                        </div>

                        <div class="small text-muted">
                            @item.Shift.Name
                        </div>
                    </td>

                    <td>
                        <div class="text-nowrap">
                            @item.Nomenclatura.Id1C
                        </div>

                        <div class="small text-muted">
                            @item.Nomenclatura.Name
                        </div>
                    </td>

                    <td class="text-end text-nowrap">
                        @item.Plan.ToString("N0")
                    </td>
                    <td class="text-end text-nowrap">
                        @(item.Execution == null
                            ? "—"
                            : item.Execution.Actual.ToString("N0"))
                    </td>

                    <td>
                            @(item.Status?.Name ?? "—")
                    </td>
                    <td>
                        <div class="d-flex flex-column gap-1">
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Изменить
                            </a>

                            <a asp-action="Execute"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-success">
                                Выполнить
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>