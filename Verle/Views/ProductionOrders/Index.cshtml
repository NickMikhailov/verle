@model System.Collections.Generic.IEnumerable<ProductionOrder>

@{
    ViewData["Title"] = "Заказы на производство";
    const int draftStatusId = 1;
    const int createdStatusId = 2;
    const int inExecutionStatusId = 3;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Заказы на производство</h1>

    <form asp-controller="ProductionOrders"
          asp-action="Create"
          method="post"
          asp-antiforgery="true"
          class="m-0">
        <button type="submit" class="btn btn-primary">
            Создать заказ
        </button>
    </form>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Заказ в 1С</th>
                <th scope="col">Дата, Смена</th>
                <th scope="col">Номенклатура</th>
                <th scope="col" class="text-end">План</th>
                <th scope="col" class="text-end">Факт</th>
                <th scope="col">Статус</th>
                <th scope="col">Действие</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="text-nowrap">
                        @(string.IsNullOrWhiteSpace(item.Id1C)
                            ? "—"
                            : item.Id1C)
                    </td>

                    <td class="text-nowrap">
                        <div>
                            @(item.OrderDate?.ToString("dd.MM.yyyy") ?? "—")
                        </div>

                        <div class="small text-muted">
                            @(item.Shift?.Name ?? "—")
                        </div>
                    </td>

                    <td>
                        <div class="text-nowrap">
                            @(item.Nomenclatura?.Id1C ?? "—")
                        </div>

                        <div class="small text-muted">
                            @(item.Nomenclatura?.Name ?? "—")
                        </div>
                    </td>

                    <td class="text-end text-nowrap">
                        @(item.Plan?.ToString("N0") ?? "—")
                    </td>

                    <td class="text-end text-nowrap">
                        @(item.Execution == null
                            ? "—"
                            : item.Execution.Actual.ToString("N0"))
                    </td>

                    <td>
                        @(item.Status?.Name ?? "—")
                    </td>

                    <td>
                        @if (item.StatusId == 4)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-success">
                                Утвердить
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-danger">
                                Отклонить
                            </button>
                        }
                        else
                        {
                            @if (item.StatusId != 3)
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Изменить
                                </a>
                            }

                            @if (item.StatusId == 2 || item.StatusId == 3)
                            {
                                <a asp-action="Execute"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-success">
                                    @(item.StatusId == 2 ? "Выполнить" : "Открыть исполнение")
                                </a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>