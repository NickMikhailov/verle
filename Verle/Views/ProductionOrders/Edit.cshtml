@model Verle.ViewModels.ProductionOrderFormViewModel

@{
    ViewData["Title"] = "Редактирование заказа ПФ Дрипы";
}

<h1>@ViewData["Title"]</h1>

<form asp-controller="ProductionOrders"
      asp-action="Edit"
      asp-route-id="@Model.Id"
      asp-antiforgery="true"
      method="post">

    <partial name="_Form" model="Model" />

    <div class="mt-4 d-flex flex-wrap gap-2">
        <button type="submit"
                name="submitAction"
                value="save"
                formnovalidate
                class="btn btn-secondary">
            Сохранить
        </button>

        <button type="submit"
                name="submitAction"
                value="create"
                class="btn btn-primary">
            @(ViewData["IsDraft"] is true ? "Создать" : "Пересоздать")
        </button>

        <a asp-controller="ProductionOrders"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Отмена
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}