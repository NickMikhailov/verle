@model System.Collections.Generic.List<Verle.Models.Employee>

@{
    ViewData["Title"] = "Сотрудники";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    <a asp-action="Create" class="btn btn-primary">
        Добавить сотрудника
    </a>
</div>

@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Сотрудники пока не добавлены.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Фамилия</th>
                    <th>Имя</th>
                    <th>Отчество</th>
                    <th>Блок</th>
                    <th>Отдел</th>
                    <th>Должность</th>
                    <th>Дата приёма</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Surname</td>
                        <td>@item.Name</td>
                        <td>@(item.Patronymic ?? "—")</td>
                        <td>@item.Position.Division.Department.Name</td>
                        <td>@item.Position.Division.Name</td>
                        <td>@item.Position.Name</td>
                        <td>@item.HireDate.ToString("dd.MM.yyyy")</td>

                        <td class="text-end text-nowrap">
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Изменить
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Удалить
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}