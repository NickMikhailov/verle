@model IEnumerable<Verle.Models.Department>

@{
    ViewData["Title"] = "Блоки";
}

<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-2 mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    <a asp-action="Create" class="btn btn-primary">
        Добавить блок
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">
        @message
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Пока нет ни одного блока. Нажмите «Добавить блок»,
        чтобы создать первую запись.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Название блока</th>
                    <th scope="col" class="text-end">Действия</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Name</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Изменить
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Удалить
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}