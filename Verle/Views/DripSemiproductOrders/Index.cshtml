@model System.Collections.Generic.IEnumerable<Verle.Models.DripSemiproductOrder>

@{
    ViewData["Title"] = "ПФ Дрипы";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">ПФ Дрипы</h1>

    <a asp-action="Create" class="btn btn-primary">
        Создать заказ
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="alert">
        @message
    </div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>ID заказа в 1С</th>
                <th>Дата</th>
                <th>Код номенклатуры в 1С</th>
                <th>Номенклатура</th>
                <th>Смена</th>
                <th>FUSO</th>
                <th class="text-end">План</th>
                <th>Факт</th>
                <th>Комментарий</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id1C</td>
                    <td class="text-nowrap">
                        @item.OrderDate.ToString("dd.MM.yyyy")
                    </td>
                    <td>@item.Nomenclatura.Id1C</td>
                    <td>@item.Nomenclatura.Name</td>
                    <td>@item.Shift.Name</td>
                    <td>@item.Fuso.FusoNumber</td>
                    <td class="text-end text-nowrap">
                        @item.Plan.ToString("N3")
                    </td>
                    <td>
                        @(item.Execution == null
                            ? "—"
                            : item.Execution.Actual.ToString("0.#"))
                    </td>
                    <td>@item.Comment</td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-secondary">
                                Просмотр
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                Изменить
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                Удалить
                            </a>
                            <a asp-action="Execute"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-success">
                                Выполнить
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>