<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Verle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Verle.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Verle</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        <!-- Меню номенклатуры -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               id="nomenclatureDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Номенклатуры
                            </a>

                            <ul class="dropdown-menu"
                                aria-labelledby="nomenclatureDropdown">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Nomenclaturas"
                                       asp-action="Index">
                                        Номенклатура
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="NomenclaturaClasses"
                                       asp-action="Index">
                                        Классы номенклатуры
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="SkuClasses"
                                       asp-action="Index">
                                        Классы SKU
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="ProductTypes"
                                       asp-action="Index">
                                        Типы продуктов
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Brands"
                                       asp-action="Index">
                                        Бренды
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="BrandGroups"
                                       asp-action="Index">
                                        Группы брендов
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Меню контрагентов -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               id="counterpartsDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Контрагенты
                            </a>

                            <ul class="dropdown-menu"
                                aria-labelledby="counterpartsDropdown">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Counterparts"
                                       asp-action="Index">
                                        Все контрагенты
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="CounterpartGroups"
                                       asp-action="Index">
                                        Группы контрагентов
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <!-- Каналы продаж -->
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="SalesChannels"
                               asp-action="Index">
                                Каналы продаж
                            </a>
                        </li>

                        <!-- Меню продаж -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               id="salesDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Продажи
                            </a>

                            <ul class="dropdown-menu"
                                aria-labelledby="salesDropdown">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Sales"
                                       asp-action="Index">
                                        Все продажи
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Sales"
                                       asp-action="Import">
                                        Импорт продаж
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <!-- Меню персонала -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               id="personnelDropdown"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                Персонал
                            </a>

                            <ul class="dropdown-menu"
                                aria-labelledby="personnelDropdown">

                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Departments"
                                       asp-action="Index">
                                        Блоки
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Divisions"
                                       asp-action="Index">
                                        Отделы
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Positions"
                                       asp-action="Index">
                                        Должности
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-area=""
                                       asp-controller="Employees"
                                       asp-action="Index">
                                        Сотрудники
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Verle - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
