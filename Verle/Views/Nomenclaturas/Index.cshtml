@model IEnumerable<Verle.Models.Nomenclatura>

@{
    ViewData["Title"] = "Номенклатура";
}

<h1>@ViewData["Title"]</h1>

<hr />

<div class="mb-4">
    <a asp-controller="Nomenclaturas"
       asp-action="Create"
       class="btn btn-primary">
        Добавить номенклатуру
    </a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Наименование</th>
                <th scope="col">ID в 1С</th>
                <th scope="col">Класс номенклатуры</th>
                <th scope="col">Класс SKU</th>
                <th scope="col">Тип продукта</th>
                <th scope="col">Бренд</th>
                <th scope="col">Действия</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7"
                        class="text-center text-muted py-4">
                        Номенклатура пока не добавлена.
                        Нажмите «Добавить номенклатуру»,
                        чтобы создать первую запись.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="text-break">
                            @Html.DisplayFor(modelItem => item.Name)
                        </td>

                        <td class="text-break">
                            @if (string.IsNullOrWhiteSpace(item.Id1C))
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @Html.DisplayFor(modelItem => item.Id1C)
                            }
                        </td>

                        <td>
                            @if (item.ClassLink?.NomenclaturaClass is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @item.ClassLink.NomenclaturaClass.Name
                            }
                        </td>

                        <td>
                            @if (item.SkuClassLink?.SkuClass is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @item.SkuClassLink.SkuClass.Name
                            }
                        </td>

                        <td>
                            @if (item.ProductTypeLink?.ProductType is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @item.ProductTypeLink.ProductType.Name
                            }
                        </td>

                        <td>
                            @if (item.BrandLink?.Brand is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                @item.BrandLink.Brand.Name
                            }
                        </td>

                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="Nomenclaturas"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Изменить
                                </a>

                                <a asp-controller="Nomenclaturas"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Подробнее
                                </a>

                                <a asp-controller="Nomenclaturas"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Удалить
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<p class="text-muted small">
    Знак «—» означает, что значение не задано.
</p>