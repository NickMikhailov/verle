@model IEnumerable<Verle.Models.ProductionSpecification>
@using System.Globalization

@{
    ViewData["Title"] = "Производственные спецификации";

    var numberCulture = CultureInfo.GetCultureInfo("ru-RU");
}

<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-2 mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    <a asp-action="Import" class="btn btn-primary">
        Импорт CSV
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Спецификации пока не загружены.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Код результата</th>
                    <th>Что производим</th>
                    <th>Код компонента</th>
                    <th>Из чего производим</th>
                    <th class="text-end">Количество компонента</th>
                    <th class="text-end">Количество результата</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.NomenclaturaOutput.Id1C</td>
                        <td>@item.NomenclaturaOutput.Name</td>
                        <td>@item.NomenclaturaInput.Id1C</td>
                        <td>@item.NomenclaturaInput.Name</td>

                        <td class="text-end text-nowrap">
                            @item.QuantityInput.ToString(
                                     "0.000000", numberCulture)
                        </td>

                        <td class="text-end text-nowrap">
                            @item.QuantityOutput.ToString(
                                     "0.000000", numberCulture)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}